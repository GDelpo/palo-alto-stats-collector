# Credenciales Palo Alto Networks — usuario con permiso para consultar XML API
USER_IP=your-palo-alto-username
PASSWORD_IP=

# Lista de IPs o FQDNs a consultar, separados por "|"
# Ejemplo: fw-core.example.com|fw-dmz.example.com|198.51.100.1
URIS=device1|device2|device3

# TLS: CA bundle (PEM) that signs the firewalls certificates. Verification is on by default.
# PANOS_CA_BUNDLE=/path/to/panos-ca.pem
# Lab devices with self-signed certificates only:
# PANOS_VERIFY_TLS=false
